{
  "version": 1,
  "caostack": "0.1.0",
  "installInto": [".agents/skills", ".cursor/plugins/caostack"],
  "exclude": [
    "solvys-skills",
    "solvys-*",
    "Codebase Cabinet",
    "internal cabinets"
  ],
  "dependencies": {
    "pstack": {
      "source": "https://github.com/cursor/plugins",
      "path": "pstack",
      "ref": "main",
      "why": "Engineering-task OS. /poteto-mode playbooks, principles, overnight, babysit, shipping."
    },
    "cursor-team-kit": {
      "source": "cursor plugin",
      "id": "cursor-team-kit",
      "why": "deslop, control-ui, control-cli. Required by pstack non-negotiables. Port to Goalpost Code plugins."
    },
    "ponytail": {
      "source": "https://ponytail.dev",
      "skills": [
        "ponytail",
        "ponytail-review",
        "ponytail-audit",
        "ponytail-debt",
        "ponytail-gain",
        "ponytail-help"
      ],
      "why": "How to write the smallest code. Not a context dump."
    },
    "shadcn-cssinjs": {
      "source": "https://github.com/shadcn-labs/shadcn-cssinjs",
      "docs": "https://shadcn-cssinjs.com/docs",
      "registry": "https://shadcn-cssinjs.com/r/{name}.json",
      "why": "Design alignment while building. StyleX + Base UI. Unofficial shadcn port."
    },
    "shadcndashboard": {
      "source": "solvys-build-kit pointer (paid zip, not this git tree)",
      "why": "Paid dashboard kits. Customers get the running product, not template source."
    },
    "impeccable": {
      "source": "agent skill impeccable",
      "why": "Polish after the feature exists. Not during implementation."
    },
    "clipth": {
      "source": "https://github.com/wavever/Clipth",
      "license": "MIT",
      "why": "OSS clipboard MCP for the local Mac. Workspace clips on Computer are first-party GPC, not this clone."
    }
  },
  "models": {
    "never": ["anthropic/*", "claude*", "fable*"],
    "roles": {
      "orchestratorPlanner": {
        "default": ["openai/gpt-5.6-sol", "openai/gpt-5.6-luna"],
        "fallback": ["xai/grok-4.6", "deepseek/deepseek-v4"]
      },
      "developer": {
        "default": [
          "deepseek/deepseek-v4-flash",
          "openai/gpt-5.6-luna",
          "cursor/composer-2.5"
        ],
        "fallback": ["deepseek/deepseek-v4", "xai/grok-4.6"]
      },
      "generalDeploy": {
        "default": ["openai/gpt-5.6-luna", "xai/grok-4.6"],
        "fallback": ["deepseek/deepseek-v4", "cursor/composer-2.5"]
      }
    },
    "resolutionOrder": [
      "oauthProvidersWithModel",
      "opencodeGoThenZenSameKey",
      "customApiBaseUrls"
    ]
  }
}
