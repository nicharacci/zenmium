# Vercel Connect connector UIDs. The deploy button provisions and sets both;
# for manual setup, create them with `vercel connect create` and paste the UIDs.
GITHUB_CONNECTOR=github/goalpost-factory-agent
LINEAR_CONNECTOR=linear/goalpost-factory-agent

# The repository the factory works on. Must be an existing GitHub repository
# in owner/repo format, and the GitHub App behind GITHUB_CONNECTOR must be
# installed with access to it: deployment clones this repository to prewarm
# the station sandboxes and fails with "Cannot access <owner/repo>" when the
# app cannot reach it. A missing or malformed value fails discovery with a
# clear error.
FACTORY_REPO=nicharacci/zenmium

# Optional: runs inside the station sandboxes' clone once per template build,
# so sessions start with dependencies installed and the repo's checks runnable.
# FACTORY_SETUP_COMMAND="pnpm install"

# Optional overrides; every one has a sensible default.
# FACTORY_LABEL="factory"            # the label that hands an issue to the factory
# FACTORY_BRANCH_PREFIX="factory/"   # branch prefix marking the factory's own PRs
# FACTORY_BOT_NAME=""                # @mention name; defaults to the GitHub App's own slug via the connector

# Cloudflare Computer (target sandbox). Browser Profile id is issued by Goalpost Code.
# GPC_BROWSER_PROFILE_ID=""
# FACTORY_SANDBOX_BACKEND="computer" # computer | vercel (eve still boots vercel until the adapter lands)
