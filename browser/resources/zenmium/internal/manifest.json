{
  "manifest_version": 3,
  "name": "Zenmium Internal",
  "version": "1.0.0",
  "description": "Zenmium internal browser-control contract and agent rail (component extension).",
  "key": "",

  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "downloads",
    "storage",
    "sidePanel",
    "alarms"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "dock/dock.html"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "web_accessible_resources": []
}
