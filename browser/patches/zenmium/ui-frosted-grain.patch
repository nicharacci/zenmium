Zenmium frosted glass: grain + 35% transparency

--- a/chrome/browser/ui/views/helium/native_frame_materials_mac.mm
+++ b/chrome/browser/ui/views/helium/native_frame_materials_mac.mm
@@ -6,12 +6,48 @@
 
 #include "base/apple/foundation_util.h"
 
+#include <cstdlib>
+
 namespace helium {
 namespace {
 
 // Low-alpha black or white overlay applied before the browser theme tint.
 constexpr CGFloat kFrameMaterialNeutralOverlayAlpha = 0.12;
 
+// Zenmium frosted grain: a deterministic luminance-noise tile generated once
+// and tiled over the theme tint at low opacity, so the glass reads textured
+// instead of flat.
+constexpr CGFloat kFrameGrainOverlayOpacity = 0.08;
+
+CGImageRef CreateFrameGrainImage() {
+  static CGImageRef grain_image = nullptr;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    constexpr NSUInteger kGrainSize = 160;
+    const NSUInteger bytes_per_row = kGrainSize * 4;
+    uint8_t* pixels =
+        static_cast<uint8_t*>(malloc(bytes_per_row * kGrainSize));
+    srand48(0x5eed);
+    for (NSUInteger i = 0; i < kGrainSize * kGrainSize; ++i) {
+      const uint8_t v =
+          static_cast<uint8_t>(128.0 + (drand48() - 0.5) * 96.0);
+      pixels[i * 4 + 0] = v;
+      pixels[i * 4 + 1] = v;
+      pixels[i * 4 + 2] = v;
+      pixels[i * 4 + 3] = 255;
+    }
+    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+    CGContextRef context = CGBitmapContextCreate(
+        pixels, kGrainSize, kGrainSize, 8, bytes_per_row, space,
+        kCGImageAlphaPremultipliedLast);
+    grain_image = CGBitmapContextCreateImage(context);
+    CGContextRelease(context);
+    CGColorSpaceRelease(space);
+    free(pixels);
+  });
+  return grain_image;
+}
+
 // Menu material is slightly brighter and more translucent in light mode,
