+Name: Zenmium internal-products component extension
+Short Name: zenmium_internal
+URL: https://github.com/nicharacci/zenmium
+Version: 1
+License: Proprietary
+License File: NOT_SHIPPED
+Security Critical: no
+Shipped: yes
+
+Zenmium's bundled component extension: the browser-control executor
+(dom-control), the native-messaging relay client, the pairing consent
+surface, and the agent rail dock. Sources live outside the Chromium
+tree at browser/resources/zenmium/internal/ in the Zenmium repository
+and are copied here by the resource pipeline before GN runs.
diff --git a/third_party/zenmium_internal/BUILD.gn b/third_party/zenmium_internal/BUILD.gn
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/third_party/zenmium_internal/BUILD.gn
@@ -0,0 +1,44 @@
+import("//ui/webui/resources/tools/generate_grd.gni")
+import("//tools/grit/grit_rule.gni")
+
+file_list = "$target_gen_dir/files.json"
+generated_grd = "$target_gen_dir/zenmium_internal_resources.grd"
+
+action("generate_file_list") {
+    script = "generate_file_list.py"
+    args = [
+        rebase_path("."),
+        rebase_path(file_list),
+    ]
+    inputs = [
+        "manifest.json",
+        "generate_file_list.py",
+    ]
+    outputs = [ file_list ]
+}
+
+generate_grd("zenmium_internal_grd") {
+    out_grd = generated_grd
+
+    grd_prefix = "zenmium_internal"
+    resource_path_prefix = "zenmium_internal"
+
+    manifest_files = [ file_list ]
+    deps = [":generate_file_list"]
+}
+
+grit("zenmium_internal") {
+    source = generated_grd
+
+    enable_input_discovery_for_gn_analyze = false
+    use_brotli = true
+
+    output_dir = "$target_gen_dir/resources"
+
+    outputs = [
+        "grit/zenmium_internal_resources.h",
+        "grit/zenmium_internal_resources_map.cc",
+        "grit/zenmium_internal_resources_map.h",
+        "zenmium_internal_resources.pak"
+    ]
+}
diff --git a/third_party/zenmium_internal/generate_file_list.py b/third_party/zenmium_internal/generate_file_list.py
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/third_party/zenmium_internal/generate_file_list.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+# Emits the grit file manifest (files.json) for the zenmium_internal
+# component extension: every file under the extension root except GN
+# build inputs and metadata.
+import json
+import os
+import sys
+
+EXCLUDE = {
+    "BUILD.gn",
+    "README.chromium",
+    "generate_file_list.py",
+    "extension_ids.h",
+    "files.json",
+}
+
+
+def main():
+    root, out = sys.argv[1], sys.argv[2]
+    files = []
+    for dirpath, _dirnames, filenames in os.walk(root):
+        for name in filenames:
+            rel = os.path.relpath(os.path.join(dirpath, name), root)
+            rel = rel.replace(os.sep, "/")
+            if rel not in EXCLUDE:
+                files.append(rel)
+    files.sort()
+    with open(out, "w") as f:
+        json.dump(files, f, indent=2)
+
+
+if __name__ == "__main__":
+    main()
